# Copy this file to .env for local commands. Do not commit .env.

# Optional guide. Without a key, the on-device reader still edits the photo.
GROQ_API_KEY=

# Public AdSense publisher id, such as ca-pub-0000000000000000.
# Leave this blank to build with no ads script and no ads.txt.
ADSENSE_CLIENT=

# Optional full ads.txt line. When this is blank and ADSENSE_CLIENT is set,
# the build writes google.com, pub-..., DIRECT, f08c47fec0942fa0.
ADSENSE_ADS_TXT=

# Storage for accounts, usage, and diagnostic reports. The first match wins.
POSTGRES_URL=
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional email after a diagnostic report is stored.
RESEND_API_KEY=
REPORT_EMAIL_FROM=

# Optional password for rating comments on the usage page.
USAGE_VIEW_KEY=
